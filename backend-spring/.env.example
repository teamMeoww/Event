# ==========================================
# EventOne Backend Environment Variables
# ==========================================
# Copy this file to .env and replace the values with your actual configuration.

# ------------------------------------------
# AI Service Configuration
# ------------------------------------------
# Which AI provider to use (e.g. openai, vertexai)
AI_PROVIDER=openai
# The model to use (e.g. gpt-3.5-turbo, gemini-1.5-pro)
AI_MODEL=gpt-3.5-turbo
# Your API key for the chosen provider
AI_API_KEY=your_api_key_here

# ------------------------------------------
# JWT Security Configuration
# ------------------------------------------
# Secret key used for signing JWT tokens (should be at least 32 bytes / 256 bits)
JWT_SECRET=defaultSecretKeyWhichShouldBeAtLeastThirtyTwoBytesLong
# Token expiration time in milliseconds (default: 3600000ms = 1 hour)
JWT_EXPIRATION=3600000

# ------------------------------------------
# QR Code Configuration
# ------------------------------------------
# Secret key used for generating and verifying QR code signatures (should be at least 32 bytes / 256 bits)
EVENTONE_QR_SECRET=defaultSuperSecretKeyForQrGenerationThatIsAtLeast32Bytes
# TTL for QR codes in seconds (default: 60)
EVENTONE_QR_TTL=60

# ------------------------------------------
# Blockchain Configuration (Foundry/Anvil)
# ------------------------------------------
# Chain ID for the blockchain network (default: 31337 for local Anvil)
EVENTONE_BLOCKCHAIN_CHAINID=31337
# RPC URL for the blockchain node (default: http://localhost:8545 for local Anvil)
EVENTONE_BLOCKCHAIN_RPCURL=http://localhost:8545
# Private key of the deployer/admin account (default: Anvil account 0)
EVENTONE_BLOCKCHAIN_PRIVATEKEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Smart contract address for Tickets
EVENTONE_TICKET_CONTRACT=0xYourTicketContractAddressHere
# Smart contract address for Credentials
EVENTONE_CREDENTIAL_CONTRACT=0xYourCredentialContractAddressHere

# ------------------------------------------
# Infrastructure Services (Optional overrides)
# ------------------------------------------
# MongoDB connection URI
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/eventone
# Redis host
# SPRING_DATA_REDIS_HOST=localhost
# Kafka bootstrap servers
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
